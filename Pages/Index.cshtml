<script>
(function(){
  var b=document.getElementById('rc-back'); if(!b) return;
  try{ if(localStorage.getItem('nudge_role_seen')) return; }catch(e){}
  var prev=null;
  function close(){ b.classList.remove('show'); try{localStorage.setItem('nudge_role_seen','1');}catch(e){} if(prev&&prev.focus) prev.focus(); }
  setTimeout(function(){ prev=document.activeElement; b.classList.add('show'); var f=b.querySelector('.rc-opt'); if(f) f.focus(); }, 900);
  document.getElementById('rc-later').addEventListener('click',close);
  document.getElementById('rc-x').addEventListener('click',close);
  b.addEventListener('click',function(e){ if(e.target===b) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&b.classList.contains('show')) close(); });
  b.querySelectorAll('.rc-opt').forEach(function(a){ a.addEventListener('click',function(){ try{localStorage.setItem('nudge_role_seen','1');}catch(e){} }); });
})();
</script>
