@page
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = "Home"; }
<p class="eyebrow">Mini freelance marketplace</p>
<h1>Post a job. Find the right freelancer.</h1>
<p>Clients publish jobs, freelancers apply with a proposal, and the site owner takes a @Config["Marketplace:CommissionPercent"]% commission on each completed job. Built with ASP.NET Core, EF Core and SQL Server as a learning project.</p>
@if (User.Identity?.IsAuthenticated != true)
{
    <p><a class="btn" href="/Account/Register">Create an account</a><a class="btn alt" href="/Jobs">Browse jobs</a></p>
}
else
{
    <p><a class="btn" href="/Jobs">Browse jobs</a></p>
}
