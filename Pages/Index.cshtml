@page
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject Marketplace.Data.AppDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Home"; ViewData["Wide"] = true; var authed = User.Identity?.IsAuthenticated == true;
    if (!decimal.TryParse(Config["Marketplace:CommissionPercent"], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var pct)) pct = 10;
    var fee = Math.Round(1480m * pct / 100m);
    var payout = 1480m - fee;
    var pctText = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var cur = Config["Marketplace:Currency"] ?? "EGP";
    var openJobs = await Db.Jobs.AsNoTracking().Include(j => j.Applications).Where(j => j.Status == Marketplace.Models.JobStatus.Open)
        .OrderByDescending(j => j.CreatedAtUtc).Take(200).ToListAsync();
    var cats = new (string Name, string Key, string[] Words)[] {
        ("Logo design","logo",new[]{"logo","brand","identity"}), ("Translation","translation",new[]{"translat","arabic","english","proofread"}),
        ("Video editing","video",new[]{"video","edit","reel","montage"}), ("Web development","website",new[]{"web","site","app","wordpress","shopify","code"}),
        ("Social media","social",new[]{"social","instagram","facebook","tiktok","post","ads"}), ("Voice over","voice",new[]{"voice","narrat","audio","dub"}) };
    string[] CatsOf(Marketplace.Models.Job j) { var t = (j.Title + " " + j.Description).ToLowerInvariant(); return cats.Where(c => c.Words.Any(w => t.Contains(w))).Select(c => c.Name).Take(3).ToArray(); }
    string FromText(string name) { var w = cats.First(c => c.Name == name).Words; var m = openJobs.Where(j => w.Any(x => (j.Title + " " + j.Description).ToLowerInvariant().Contains(x))).Select(j => j.Budget).ToList(); return m.Count == 0 ? "No open jobs yet" : "Jobs from " + m.Min().ToString("N0") + " " + cur; }
    string Ago(DateTime d) { var t = DateTime.UtcNow - d; if (t.TotalMinutes < 60) return $"{Math.Max(1, (int)t.TotalMinutes)} min ago"; if (t.TotalHours < 24) return $"{(int)t.TotalHours} hour(s) ago"; return $"{(int)t.TotalDays} day(s) ago"; }
    var recent = openJobs.Take(3).ToList();
}
<style>
    .home { position: relative; }
