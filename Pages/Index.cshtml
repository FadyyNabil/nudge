<script>
document.addEventListener("DOMContentLoaded", function () {
  try {
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var fine = window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    // Hero spotlight follows the pointer
    var home = document.querySelector(".home");
    if (home && fine) {
      home.addEventListener("pointermove", function (e) {
        var r = home.getBoundingClientRect();
        home.style.setProperty("--mx", (e.clientX - r.left) + "px");
        home.style.setProperty("--my", (e.clientY - r.top) + "px");
        home.classList.add("lit");
      });
      home.addEventListener("pointerleave", function () { home.classList.remove("lit"); });
    }

    // Typewriter: cycles through what people hire for
    var rot = document.getElementById("rot-word");
    if (rot && !reduce) {
      var words = ["logo designer", "translator", "video editor", "web developer", "voice over artist", "social media manager"];
      var wi = 0, ci = words[0].length, del = true;
      (function tick() {
        var w = words[wi];
        if (del) { ci--; } else { ci++; }
        rot.textContent = w.slice(0, ci);
        var d = del ? 38 : 80;
        if (!del && ci === w.length) { del = true; d = 1500; }
        else if (del && ci === 0) { del = false; wi = (wi + 1) % words.length; d = 250; }
        setTimeout(tick, d);
      })();
    }

    // Counters count up when they scroll into view
    var counters = document.querySelectorAll("[data-count]");
    function runCount(el) {
      var to = parseFloat(el.getAttribute("data-count")), suf = el.getAttribute("data-suffix") || "";
      if (isNaN(to)) return;
      var dec = (String(el.getAttribute("data-count")).split(".")[1] || "").length, t0 = null, dur = 1400;
      function step(t) {
        if (t0 === null) t0 = t;
        var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = (to * e).toFixed(dec) + suf;
        if (p < 1) requestAnimationFrame(step);
      }
      el.textContent = (0).toFixed(dec) + suf;
      requestAnimationFrame(step);
    }
    if (!reduce && "IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (x) { if (x.isIntersecting) { runCount(x.target); io.unobserve(x.target); } });
      }, { threshold: .6 });
      counters.forEach(function (c) { io.observe(c); });
    }

    // Tagline: words light up one at a time as they cross the trigger line
    var tg = document.getElementById("tagline");
    if (tg && !reduce && "IntersectionObserver" in window) {
      tg.innerHTML = tg.textContent.trim().split(/\s+/).map(function (w) { return '<span class="tw">' + w + '</span>'; }).join(" ");
      tg.classList.add("split");
      var tio = new IntersectionObserver(function (es) {
        es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add("on"); tio.unobserve(x.target); } });
      }, { rootMargin: "0px 0px -38% 0px", threshold: 0 });
      tg.querySelectorAll(".tw").forEach(function (w) { tio.observe(w); });
    }

    // Interactive "how it works": click a step or let it play
    var hw = document.getElementById("hw");
    if (hw) {
      var steps = hw.querySelectorAll(".hw-step"), panels = hw.querySelectorAll(".hw-panel");
      var dur = parseInt(hw.getAttribute("data-dur"), 10) || 5000, cur = 0, timer = null, visible = false, hover = false;
      hw.style.setProperty("--dur", dur + "ms");
      function show(i) {
        cur = i;
        steps.forEach(function (s, k) {
          var on = k === i;
          s.classList.remove("on"); void s.offsetWidth;
          if (on) s.classList.add("on");
          s.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach(function (p, k) { p.classList.toggle("on", k === i); });
      }
      function arm() {
        clearTimeout(timer);
        if (reduce || !visible || hover) return;
        timer = setTimeout(function () { show((cur + 1) % steps.length); arm(); }, dur);
      }
      steps.forEach(function (s, k) { s.addEventListener("click", function () { show(k); arm(); }); });
      hw.addEventListener("pointerenter", function (e) { if (e.pointerType !== "mouse") return; hover = true; hw.classList.add("paused"); clearTimeout(timer); });
      hw.addEventListener("pointerleave", function (e) { if (e.pointerType !== "mouse") return; hover = false; hw.classList.remove("paused"); show(cur); arm(); });
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) { visible = es[0].isIntersecting; if (visible) { show(cur); } arm(); }, { threshold: .35 }).observe(hw);
      }
    }
  } catch (e) { try { console.warn("home fx off", e); } catch (_) {} }
});
</script>
