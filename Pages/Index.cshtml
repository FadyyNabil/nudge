@page
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Home"; ViewData["Wide"] = true; var authed = User.Identity?.IsAuthenticated == true;
    if (!decimal.TryParse(Config["Marketplace:CommissionPercent"], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var pct)) pct = 10;
    var fee = Math.Round(1480m * pct / 100m);
    var payout = 1480m - fee;
    var pctText = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<style>
    .home { position: relative; }
    .home::before { content: ""; position: absolute; inset: -40px 0; pointer-events: none; z-index: 0; opacity: 0; transition: opacity .4s cubic-bezier(.22,1,.36,1);
        background: radial-gradient(420px circle at var(--mx, 30%) var(--my, 30%), #3157d51f, transparent 65%); }
    .home.lit::before { opacity: 1; }
    .home > * { position: relative; z-index: 1; }
    .rotator { font-size: clamp(17px, 2.4vw, 22px); color: var(--ink); margin: 0 0 14px; min-height: 1.6em; }
    .rotator .rot-word { color: var(--accent); font-weight: 600; border-bottom: 2px solid var(--accent); padding-bottom: 1px; }
    .rotator .caret { display: inline-block; width: 2px; height: 1.05em; background: var(--accent); margin-left: 3px; vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
    @@keyframes blink { 50% { opacity: 0; } }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
    .chips a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px;
        text-decoration: none; background: var(--card); color: var(--ink); transition: transform .2s cubic-bezier(.22,1,.36,1), border-color .2s cubic-bezier(.22,1,.36,1), background .2s cubic-bezier(.22,1,.36,1), color .2s cubic-bezier(.22,1,.36,1), box-shadow .2s cubic-bezier(.22,1,.36,1); }
    .chips a:hover { transform: translateY(-3px) scale(1.04); border-color: var(--accent); color: var(--accent); box-shadow: 0 8px 18px #3157d522; }
    .stage3d { position: relative; margin: 28px 0 0; height: 360px; border-radius: 14px; border: 1px solid var(--line); overflow: hidden; cursor: grab; touch-action: pan-y;
        background: radial-gradient(60% 80% at 50% 45%, #3157d533, transparent 70%), linear-gradient(160deg, var(--wash), var(--card)); }
    .stage3d.grab { cursor: grabbing; }
    .stage3d canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .8s cubic-bezier(.22,1,.36,1); }
    .stage3d.live canvas { opacity: 1; }
    .stage3d .st-fallback { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity .6s cubic-bezier(.22,1,.36,1); pointer-events: none; }
    .stage3d.live .st-fallback { opacity: 0; }
    .st-fallback svg { width: min(46%, 240px); height: auto; animation: floaty 6s ease-in-out infinite; }
    .st-cap { position: absolute; left: 16px; bottom: 12px; font-size: 12px; color: var(--muted); pointer-events: none; display: flex; gap: 8px; align-items: center; }
    .st-cap i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
    @@media (max-width: 800px) { .stage3d { height: 280px; margin-top: 20px; } }
    @@media (prefers-reduced-motion: reduce) { .st-fallback svg { animation: none; } }
    .join { position: relative; }
    .float-badge { position: absolute; display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; font-size: 12px; font-weight: 600;
        background: var(--card); color: var(--ink); border: 1px solid var(--line); box-shadow: 0 10px 26px #0b1f4d26; animation: floaty 5s ease-in-out infinite; pointer-events: none; }
    .float-badge i { width: 8px; height: 8px; border-radius: 50%; background: #1fa971; display: inline-block; }
    .float-badge.fb1 { top: -16px; right: 14px; }
    .float-badge.fb2 { bottom: -16px; left: 14px; animation-delay: -2.4s; }
    @@keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 36px 0 0; }
    .stat { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px 18px; text-align: left; position: relative; overflow: hidden; }
    .stat b { display: block; font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 4vw, 38px); line-height: 1.1; color: var(--accent); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .stat span { display: block; font-size: 13px; color: var(--muted); margin-top: 6px; line-height: 1.4; }
    .stat::after { content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.22,1,.36,1); }
    .stat:hover::after { transform: scaleX(1); }
    .fx-spot { position: relative; }
    .fx-spot > .fx-glow { position: absolute; inset: 0; pointer-events: none; border-radius: inherit; opacity: 0; transition: opacity .3s cubic-bezier(.22,1,.36,1);
        background: radial-gradient(260px circle at var(--sx, 50%) var(--sy, 50%), #3157d51c, transparent 70%); }
    .fx-spot:hover > .fx-glow { opacity: 1; }
    .tagline { max-width: 680px; margin: 72px auto 40px; text-align: left; font-family: var(--serif); font-weight: 600; font-size: clamp(26px, 4.4vw, 36px); line-height: 1.25; letter-spacing: -.02em; text-wrap: balance; }
    .tagline .tw { transition: opacity .5s cubic-bezier(.22,1,.36,1); }
    .tagline.split .tw { opacity: .3; }
    .tagline.split .tw.on { opacity: 1; }
    .hw { display: grid; grid-template-columns: 1fr 1.05fr; gap: 28px; align-items: stretch; margin-top: 18px; }
    .hw-list { display: flex; flex-direction: column; gap: 8px; }
    .hw-step { position: relative; display: grid; grid-template-columns: 38px 1fr; gap: 12px; text-align: left; font: inherit; color: var(--ink); background: transparent;
        border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; cursor: pointer; transition: background .25s cubic-bezier(.22,1,.36,1), border-color .25s cubic-bezier(.22,1,.36,1), transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s cubic-bezier(.22,1,.36,1); overflow: hidden; }
    .hw-step:hover { transform: translateX(4px); border-color: var(--accent); }
    .hw-step .n { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 14px; background: var(--wash); color: var(--accent); transition: background .25s cubic-bezier(.22,1,.36,1), color .25s cubic-bezier(.22,1,.36,1), transform .3s cubic-bezier(.22,1,.36,1); }
    .hw-step strong { display: block; font-size: 15px; line-height: 1.35; }
    .hw-step small { display: block; font-size: 13px; color: var(--muted); line-height: 1.5; margin-top: 2px; }
    .hw-step:active, .chips a:active { transform: scale(.98); }
    .hw-step:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    .hw-step.on { background: var(--wash); border-color: var(--accent); box-shadow: 0 10px 26px #3157d520; }
    .hw-step.on .n { background: var(--accent); color: #fff; transform: scale(1.1); }
    [data-theme="dark"] .hw-step.on .n { color: #0a1430; }
    .hw-step i { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
    .hw-step.on i { animation: hwbar var(--dur, 5s) linear forwards; }
    .hw.paused .hw-step.on i { animation-play-state: paused; }
    @@keyframes hwbar { to { transform: scaleX(1); } }
    .hw-stage { position: relative; min-height: 300px; border-radius: 12px; border: 1px solid var(--line); background: linear-gradient(160deg, var(--wash), var(--card)); padding: 20px; overflow: hidden; }
    .hw-panel { position: absolute; inset: 20px; opacity: 0; transform: translateY(14px) scale(.98); transition: opacity .45s cubic-bezier(.22,1,.36,1), transform .45s cubic-bezier(.22,1,.36,1); pointer-events: none; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
    .hw-panel.on { opacity: 1; transform: none; pointer-events: auto; }
    .mock { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 14px; box-shadow: 0 8px 20px #0b1f4d14; }
    .mock .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); display: block; }
    .mock .big { font-weight: 600; }
    .mock.row, .mock .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .mock .pill-ok { font-size: 12px; font-weight: 600; color: #1fa971; }
    .mock .av { width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 12px; font-weight: 700; flex: none; }
    [data-theme="dark"] .mock .av { color: #0a1430; }
    .mock .mbtn { display: inline-block; background: var(--accent); color: #fff; border-radius: 4px; padding: 6px 14px; font-size: 13px; font-weight: 600; }
    [data-theme="dark"] .mock .mbtn { color: #0a1430; }
    .hw-panel.on .mock { animation: mockin .55s cubic-bezier(.22,1,.36,1) both; }
    .hw-panel.on .mock:nth-child(2) { animation-delay: .08s; }
    .hw-panel.on .mock:nth-child(3) { animation-delay: .16s; }
    .hw-panel.on .mock:nth-child(4) { animation-delay: .24s; }
    @@keyframes mockin { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .hw-note { font-size: 12px; color: var(--muted); margin: 10px 0 0; }
    .lock { display: inline-block; width: 14px; height: 11px; border-radius: 2px; background: var(--accent); position: relative; margin-right: 6px; vertical-align: -1px; }
    .lock::before { content: ""; position: absolute; left: 2px; top: -6px; width: 6px; height: 6px; border: 2px solid var(--accent); border-bottom: 0; border-radius: 6px 6px 0 0; }
    @@media (max-width: 800px) { .stats { grid-template-columns: 1fr 1fr; } .hw { grid-template-columns: 1fr; } .hw-stage { min-height: 300px; } .float-badge.fb1 { right: 8px; } }
    @@media (max-width: 420px) { .stat { padding: 16px 14px; } }
    @@media (prefers-reduced-motion: reduce) { .float-badge, .rotator .caret { animation: none; } .hw-panel, .hw-step { transition: none; } .hw-step.on i { animation: none; transform: scaleX(1); } }
</style>
<div class="home">
    <section>
        <h1 class="home-title">Find a freelancer in Egypt, or find your next gig.</h1>
        <p class="rotator" aria-hidden="true">Hire a <span class="rot-word" id="rot-word">logo designer</span><span class="caret"></span></p>
        <p class="home-sub">Post a job with a budget in EGP, pick a freelancer from the proposals, and pay through InstaPay or a mobile wallet. We hold the money until you say the work is done.</p>
        <form method="get" action="/Jobs" class="home-search">
            <input name="q" id="home-q" placeholder="Search jobs, for example logo or translation" aria-label="Search jobs" />
            <button class="btn small" type="submit">Search</button>
        </form>
        <ul class="chips" aria-label="Popular searches">
            <li><a href="/Jobs?q=logo">Logo design</a></li>
            <li><a href="/Jobs?q=translation">Translation</a></li>
            <li><a href="/Jobs?q=video">Video editing</a></li>
            <li><a href="/Jobs?q=website">Web development</a></li>
            <li><a href="/Jobs?q=social">Social media</a></li>
            <li><a href="/Jobs?q=voice">Voice over</a></li>
        </ul>
        <div class="hero-cta">
        @if (!authed)
        {
            <a class="btn small" href="/Account/Register">Join Nudge</a>
            <a class="btn small alt" href="/Account/Login">Sign in</a>
        }
        else
        {
            <a class="btn small" href="/Dashboard">Open dashboard</a>
            <a class="btn small alt" href="/Jobs">Browse jobs</a>
        }
        </div>
    </section>
    <div class="hero-art">
        <div class="hero-deco" aria-hidden="true"><i class="c1"></i><i class="c2"></i><i class="c3"></i></div>
        <span class="float-badge fb1" aria-hidden="true"><i></i> Held by Nudge until you approve</span>
        <span class="float-badge fb2" aria-hidden="true"><i></i> Paid in EGP</span>
        <div class="stage3d" id="stage3d" aria-hidden="true">
    <div class="st-fallback"><svg viewBox="0 0 120 120" fill="none" stroke="var(--accent)" stroke-width="2"><polygon points="60,8 106,34 106,86 60,112 14,86 14,34" fill="var(--wash)"/><polyline points="14,34 60,60 106,34"/><line x1="60" y1="60" x2="60" y2="112"/></svg></div>
    <canvas id="stage3d-canvas"></canvas>
    <span class="st-cap"><i></i> Drag to spin</span>
        </div>
    </div>
</div>

<div class="stats">
    <div class="stat"><b data-count="@pctText" data-suffix="%">@pctText%</b><span>platform commission, taken only when work is approved</span></div>
    <div class="stat"><b data-count="100" data-suffix="%">100%</b><span>of the payment held until you approve</span></div>
    <div class="stat"><b>EGP</b><span>InstaPay and mobile wallets</span></div>
    <div class="stat"><b data-count="4">4</b><span>steps from posting a job to getting paid</span></div>
</div>

<p class="tagline" id="tagline">Your money stays safe until the work is done. Then the freelancer gets paid, and you get exactly what you asked for.</p>

<div class="zig" aria-label="Why Nudge">
    <section class="zrow">
        <div class="zvis blue" aria-hidden="true">
            <div class="zdeco"><i class="c1"></i><i class="c2"></i></div>
            <span class="zn">N</span>
            <div class="mock"><span class="lbl">Payment</span><span class="big"><span class="lock"></span>1,480 EGP held by Nudge</span></div>
            <div class="mock row"><span class="big">Work approved</span><span class="pill-ok">Released</span></div>
        </div>
        <div class="ztext">
            <p class="eyebrow">Why Nudge</p>
            <h3>Your money is protected from day one</h3>
            <p>The client pays when hiring, and Nudge holds the money. Neither side can touch it. When the work is approved, the freelancer is paid automatically, minus a clear @pctText% commission.</p>
            <a class="zlink" href="#how">See the four steps</a>
        </div>
    </section>
    <section class="zrow flip">
        <div class="zvis wash" aria-hidden="true">
            <div class="zdeco"><i class="c1"></i><i class="c2"></i></div>
            <span class="zn">N</span>
            <div class="mock row"><span class="row" style="gap:10px"><span class="av">SM</span><span><span class="big">Sara M.</span><span class="lbl">Portfolio: 6 items</span></span></span><span class="big">1,390 EGP</span></div>
            <div class="mock row"><span class="row" style="gap:10px"><span class="av">AK</span><span><span class="big">Ahmed K.</span><span class="lbl">Portfolio: 9 items</span></span></span><span class="big">1,480 EGP</span></div>
        </div>
        <div class="ztext">
            <p class="eyebrow">For clients</p>
            <h3>Real portfolios, reviewed proposals</h3>
            <p>Freelancers can only apply with portfolio work on their profile, and every proposal is reviewed before it reaches you. Compare real work and clear prices in EGP, then pick with confidence.</p>
            <a class="zlink" href="/Jobs">Browse open jobs</a>
        </div>
    </section>
    <section class="zrow">
        <div class="zvis blue" aria-hidden="true">
            <div class="zdeco"><i class="c1"></i><i class="c2"></i></div>
            <span class="zn">N</span>
            <div class="mock"><span class="lbl">Paid with</span><span class="big">InstaPay or a mobile wallet</span></div>
            <div class="mock row"><span class="big">You receive</span><span class="big pill-ok">@payout.ToString("N0") EGP</span></div>
        </div>
        <div class="ztext">
            <p class="eyebrow">For freelancers</p>
            <h3>Paid in EGP, the way Egypt pays</h3>
            <p>No international wires, no waiting on foreign platforms. When the client approves the work, your money moves straight to your InstaPay or wallet, in pounds.</p>
            <a class="zlink" href="/Account/Register">Make a profile</a>
        </div>
    </section>
</div>


<section class="band lav how" id="how">
    <h2>How a job works</h2>
    <div class="hw" id="hw" data-dur="5200">
        <div class="hw-list" role="tablist" aria-label="Steps">
            <button type="button" class="hw-step on" role="tab" aria-selected="true" data-i="0"><span class="n">1</span><span><strong>A client posts a job.</strong><small>A short description and a budget.</small></span><i></i></button>
            <button type="button" class="hw-step" role="tab" aria-selected="false" data-i="1"><span class="n">2</span><span><strong>Freelancers send proposals.</strong><small>Only people with portfolio work on their profile can apply.</small></span><i></i></button>
            <button type="button" class="hw-step" role="tab" aria-selected="false" data-i="2"><span class="n">3</span><span><strong>The client hires one and pays.</strong><small>The money sits with Nudge, not with either side.</small></span><i></i></button>
            <button type="button" class="hw-step" role="tab" aria-selected="false" data-i="3"><span class="n">4</span><span><strong>The work is approved.</strong><small>The freelancer is paid, minus our @pctText% commission.</small></span><i></i></button>
        </div>
        <div class="hw-stage" aria-live="polite">
            <div class="hw-panel on">
                <div class="mock"><span class="lbl">Job title</span><span class="big">Logo for my bakery</span></div>
                <div class="mock row"><div><span class="lbl">Budget</span><span class="big">1,480 EGP</span></div><span class="mbtn">Post job</span></div>
            </div>
            <div class="hw-panel">
                <div class="mock row"><span class="row" style="gap:10px"><span class="av">SM</span><span><span class="big">Sara M.</span><span class="lbl">Portfolio: 6 items</span></span></span><span class="big">1,390 EGP</span></div>
                <div class="mock row"><span class="row" style="gap:10px"><span class="av">AK</span><span><span class="big">Ahmed K.</span><span class="lbl">Portfolio: 9 items</span></span></span><span class="big">1,480 EGP</span></div>
                <div class="mock row"><span class="row" style="gap:10px"><span class="av">NH</span><span><span class="big">Nour H.</span><span class="lbl">Portfolio: 4 items</span></span></span><span class="big">1,215 EGP</span></div>
            </div>
            <div class="hw-panel">
                <div class="mock row"><span class="big">Hired: Ahmed K.</span><span class="pill-ok">Accepted</span></div>
                <div class="mock"><span class="lbl">Payment</span><span class="big"><span class="lock"></span>1,480 EGP held by Nudge</span></div>
                <div class="mock"><span class="lbl">Status</span><span class="big">Work in progress</span></div>
            </div>
            <div class="hw-panel">
                <div class="mock row"><span class="big">Work approved</span><span class="pill-ok">Done</span></div>
                <div class="mock row"><span>Payment</span><span class="big">1,480 EGP</span></div>
                <div class="mock row"><span>Commission (@pctText%)</span><span class="big">minus @fee.ToString("N0") EGP</span></div>
                <div class="mock row"><span>Freelancer receives</span><span class="big pill-ok">@payout.ToString("N0") EGP</span></div>
            </div>
        </div>
    </div>
    <p class="hw-note" style="margin-bottom:0">Example screens with invented names and numbers.</p>
</section>

<script>
(function(){
  var st=document.getElementById('stage3d'); if(!st) return;
  var c=navigator.connection||{}, rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var weak=c.saveData||/(^|-)2g$/.test(c.effectiveType||'')||(navigator.deviceMemory&&navigator.deviceMemory<=2)||(navigator.hardwareConcurrency&&navigator.hardwareConcurrency<=2);
  var gl=false; try{var t=document.createElement('canvas'); gl=!!(t.getContext('webgl2')||t.getContext('webgl'));}catch(e){}
  if(rm||(weak&&location.search.indexOf("3d=force")<0)||!gl) return;
  var go=function(){ if(go.d) return; go.d=1; import('/js/hero3d.js?v=1').catch(function(){}); };
  if('IntersectionObserver' in window){ new IntersectionObserver(function(es,o){ if(es[0].isIntersecting){o.disconnect(); (window.requestIdleCallback||setTimeout)(go);} },{rootMargin:'200px'}).observe(st); } else go();
})();
