@page
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = "Home"; ViewData["Wide"] = true; var authed = User.Identity?.IsAuthenticated == true; }
<div class="home">
    <section>
        <h1 class="home-title">Find a freelancer in Egypt, or find your next gig.</h1>
        <p class="home-sub">Post a job with a budget in EGP, pick a freelancer from the proposals, and pay through InstaPay or a mobile wallet. We hold the money until you say the work is done.</p>
        <form method="get" action="/Jobs" class="home-search">
            <input name="q" placeholder="Search jobs, for example logo or translation" aria-label="Search jobs" />
            <button class="btn small" type="submit">Search</button>
        </form>
    </section>
    <aside class="card join">
        @if (!authed)
        {
            <strong>New here?</strong>
            <p>Make an account in a minute. Clients post jobs, freelancers send proposals.</p>
            <a class="btn small" href="/Account/Register">Join Sho8lana</a>
            <a class="btn small alt" href="/Account/Login">Sign in</a>
        }
        else
        {
            <strong>Welcome back</strong>
            <p>Pick up where you left off.</p>
            <a class="btn small" href="/Dashboard">Open dashboard</a>
            <a class="btn small alt" href="/Jobs">Browse jobs</a>
        }
    </aside>
</div>

<section class="card how">
    <h2>How a job works</h2>
    <ol class="flow">
        <li><strong>A client posts a job.</strong> A short description and a budget.</li>
        <li><strong>Freelancers send proposals.</strong> Only people with portfolio work on their profile can apply.</li>
        <li><strong>The client hires one and pays.</strong> The money sits with Sho8lana, not with either side.</li>
        <li><strong>The work is approved.</strong> The freelancer is paid, minus our @Config["Marketplace:CommissionPercent"]% commission.</li>
    </ol>
</section>
