@page
@model Marketplace.Pages.Admin.TransactionsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = "Transactions"; var cur = Config["Marketplace:Currency"]; }
<p class="eyebrow">Owner</p>
<h1>Transactions</h1>
<p>Bookkeeping only. No real money moves through this app.</p>
<ul class="facts">
    <li><span>Commission earned</span><strong>@Model.Earned.ToString("N2") @cur</strong></li>
    <li><span>Commission pending</span><strong>@Model.Pending.ToString("N2") @cur</strong></li>
</ul>
<h2>All transactions (@Model.Rows.Count)</h2>
@if (!Model.Rows.Any()) { <p>No accepted jobs yet.</p> }
else
{
<div class="table-wrap">
<table class="t">
    <thead><tr><th>Job</th><th>Client</th><th>Agreed</th><th>Commission</th><th>Payment</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var j in Model.Rows)
    {
        <tr>
            <td><a href="/Jobs/Details/@j.Id">@j.Title</a></td>
            <td>@j.Client!.FullName</td>
            <td>@(j.AgreedPrice?.ToString("N2")) @cur</td>
            <td>@(j.CommissionAmount?.ToString("N2")) @cur</td>
            <td>@(j.PaymentMethod is null ? "-" : PaymentMethodNames.Label(j.PaymentMethod.Value))</td>
            <td><span class="pill">@j.Status</span></td>
        </tr>
    }
    </tbody>
</table>
</div>
}
