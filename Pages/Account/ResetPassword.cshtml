@page
@model Marketplace.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<p class="eyebrow">Account</p>
<h1>Choose a new password</h1>
@if (Model.Invalid)
{
    <p class="error-box">This reset link is not valid any more. Links work for 1 hour and only once.</p>
    <p><a class="btn" href="/Account/ForgotPassword">Get a new link</a></p>
}
else
{
    <form method="post" class="card">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <input type="hidden" name="T" value="@Model.T" />
        <label asp-for="Input.Password">New password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="error"></span>
        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="error"></span>
        <button type="submit" class="btn">Save new password</button>
    </form>
}
