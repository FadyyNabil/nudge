@page
@model Marketplace.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<p class="eyebrow">Account</p>
<h1>Forgot your password?</h1>
@if (Model.Sent)
{
    <p class="ok">If an account exists for that email, we sent a reset link. It works for 1 hour. Check your spam folder too.</p>
}
else
{
    <p class="body-text">Enter your email and we will send you a link to choose a new password.</p>
    <form method="post" class="card">
        <label for="Email">Email</label>
        <input id="Email" name="Email" type="email" value="@Model.Email" autocomplete="email" required maxlength="256" />
        <button type="submit" class="btn">Send reset link</button>
    </form>
}
<p><a href="/Account/Login">Back to log in</a></p>
