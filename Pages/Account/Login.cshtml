@page
@model Marketplace.Pages.Account.LoginModel
@{ ViewData["Title"] = "Log in"; }
<p class="eyebrow">Welcome back</p>
<h1>Log in</h1>
@if (Model.Registered)
{
    <p class="ok">Account created. It is under review. You can log in once the owner approves it.</p>
}
@if (!string.IsNullOrEmpty(Model.LoginError))
{
    <p class="error">@Model.LoginError</p>
}
@if (Model.GoogleEnabled || Model.LinkedInEnabled)
{
    <style>
        .social { display: flex; flex-direction: column; gap: 12px; }
        .social-btn { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; min-height: 46px; padding: 0 20px;
            border-radius: 999px; font-size: 15px; font-weight: 600; text-decoration: none; border: 1px solid transparent;
            transition: background .15s, box-shadow .15s, border-color .15s; }
        .social-btn svg { width: 20px; height: 20px; flex: none; }
        .social-btn.google { background: #fff; color: #3c4043; border-color: #dadce0; }
        .social-btn.google:hover { background: #f8f9fa; border-color: #c6c9cc; box-shadow: 0 1px 3px #0b1f4d26; }
        .social-btn.linkedin { background: #0a66c2; color: #fff; }
        .social-btn.linkedin:hover { background: #004182; box-shadow: 0 1px 3px #0b1f4d40; }
        .social-btn:focus-visible { outline: 3px solid #3157d5; outline-offset: 2px; }
        .or-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0 0; color: var(--muted); font-size: 13px; }
        .or-divider::before, .or-divider::after { content: ""; flex: 1; border-top: 1px solid var(--line); }
    </style>
    <div class="card">
        <div class="social">
            @if (Model.GoogleEnabled)
            {
                <a class="social-btn google" href="/Account/ExternalLogin?provider=Google">
                    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                    <span>Continue with Google</span>
                </a>
            }
            @if (Model.LinkedInEnabled)
            {
                <a class="social-btn linkedin" href="/Account/ExternalLogin?provider=LinkedIn">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                    <span>Continue with LinkedIn</span>
                </a>
            }
        </div>
        <div class="or-divider">or use your email</div>
    </div>
}
<form method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" autocomplete="email" />
    <span asp-validation-for="Input.Email" class="error"></span>

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="error"></span>

    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit" class="btn">Log in</button>
</form>
<p>No account yet? <a href="/Account/Register">Sign up</a></p>
