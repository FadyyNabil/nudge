@page
@model Marketplace.Pages.Account.LoginModel
@{ ViewData["Title"] = "Log in"; }
<p class="eyebrow">Welcome back</p>
<h1>Log in</h1>
@if (Model.Registered)
{
    <p class="ok">Account created. It is under review. You can log in once the owner approves it.</p>
}
@if (!string.IsNullOrEmpty(Model.LoginError))
{
    <p class="error">@Model.LoginError</p>
}
@if (Model.GoogleEnabled || Model.LinkedInEnabled)
{
    <div class="card">
        @if (Model.GoogleEnabled)
        {
            <p><a class="btn alt" href="/Account/ExternalLogin?provider=Google">Continue with Google</a></p>
        }
        @if (Model.LinkedInEnabled)
        {
            <p><a class="btn alt" href="/Account/ExternalLogin?provider=LinkedIn">Continue with LinkedIn</a></p>
        }
        <p class="meta">Or use your email and password:</p>
    </div>
}
<form method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" autocomplete="email" />
    <span asp-validation-for="Input.Email" class="error"></span>

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="error"></span>

    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit" class="btn">Log in</button>
</form>
<p>No account yet? <a href="/Account/Register">Sign up</a></p>
