@page
@model Marketplace.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Sign up"; }
<p class="eyebrow">Sign up</p>
<h1>Create an account</h1>
@if (Model.FromProvider is not null)
{
    <p class="ok">@Model.FromProvider connected. Finish creating your account below.</p>
}
<form method="post" enctype="multipart/form-data" class="card">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Input.FullName">Full name</label>
    <input asp-for="Input.FullName" autocomplete="name" />
    <span asp-validation-for="Input.FullName" class="error"></span>

    <label asp-for="Input.Role">I want to</label>
    <select asp-for="Input.Role">
        <option value="Freelancer">Find work (Freelancer)</option>
        <option value="Client">Hire people (Client)</option>
    </select>
    <span asp-validation-for="Input.Role" class="error"></span>

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" autocomplete="email" />
    <span asp-validation-for="Input.Email" class="error"></span>

    <label asp-for="Input.PortfolioUrl">Portfolio link</label>
    <input asp-for="Input.PortfolioUrl" type="url" placeholder="https://" autocomplete="url" />
    <span class="meta">Required for freelancers. Clients can leave it empty.</span>
    <span asp-validation-for="Input.PortfolioUrl" class="error"></span>

    <div id="freelancerFields">
        <label asp-for="Cv">CV (PDF, PNG or JPG)</label>
        <input asp-for="Cv" type="file" accept=".pdf,.png,.jpg,.jpeg" />
        <span class="meta">Required for freelancers. Up to 5 MB.</span>
        <span asp-validation-for="Cv" class="error"></span>

        <label asp-for="Input.InstaPayNumber">InstaPay number</label>
        <input asp-for="Input.InstaPayNumber" placeholder="e.g. 0100 123 4567" />
        <span class="meta">Required for freelancers, so clients can pay you.</span>
        <span asp-validation-for="Input.InstaPayNumber" class="error"></span>
    </div>

    <div id="clientFields" style="display:none">
        <p><strong>Payment card</strong> <span class="pill">demo only</span></p>
        <p class="meta">Demo only: nothing is saved and nothing is charged. Do not enter real card details.</p>
        <label for="DemoCardNumber">Card number</label>
        <input id="DemoCardNumber" name="DemoCardNumber" inputmode="numeric" placeholder="4242 4242 4242 4242" autocomplete="off" />
        <label for="DemoCardExpiry">Expiry</label>
        <input id="DemoCardExpiry" name="DemoCardExpiry" placeholder="MM/YY" autocomplete="off" />
        <label for="DemoCardCvc">CVC</label>
        <input id="DemoCardCvc" name="DemoCardCvc" inputmode="numeric" placeholder="123" autocomplete="off" />
    </div>

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" autocomplete="new-password" />
    <span asp-validation-for="Input.Password" class="error"></span>

    <label asp-for="Input.ConfirmPassword">Confirm password</label>
    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
    <span asp-validation-for="Input.ConfirmPassword" class="error"></span>

    <p class="meta">New accounts are reviewed by the owner before you can log in.</p>
    <button type="submit" class="btn">Sign up</button>
</form>
<p>Already have an account? <a href="/Account/Login">Log in</a></p>

<script>
(function () {
    var role = document.getElementById('Input_Role');
    var freelancer = document.getElementById('freelancerFields');
    var client = document.getElementById('clientFields');
    function sync() {
        var isFreelancer = role.value === 'Freelancer';
        freelancer.style.display = isFreelancer ? '' : 'none';
        client.style.display = isFreelancer ? 'none' : '';
    }
    role.addEventListener('change', sync);
    sync();
})();
</script>
