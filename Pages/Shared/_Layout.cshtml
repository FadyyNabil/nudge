@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var siteName = Config["Marketplace:SiteName"] ?? "Sho8lana";
    var authed = User.Identity?.IsAuthenticated == true;
    var isAdmin = authed && User.IsInRole("Admin");
    var path = Context.Request.Path.Value ?? "/";
    string Act(string p, bool exact = false) => (exact ? path.Equals(p, StringComparison.OrdinalIgnoreCase) : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? " class=\"active\"" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @siteName</title>
    <script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.setAttribute("data-theme",t);}catch(e){}</script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>@@media (max-width:650px){header{padding:6px 16px;gap:0 12px;min-height:0}nav{width:100%;gap:6px 12px;padding-bottom:6px}nav a.nav-ghost,nav a.nav-cta{padding:0 12px}h1{font-size:24px}}</style>
    <style>
        .mo-bg{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
        .mo-blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.28;will-change:transform}
        .mo-blob.b1{width:46vmax;height:46vmax;left:-14vmax;top:-12vmax;background:#3157d5}
        .mo-blob.b2{width:38vmax;height:38vmax;right:-12vmax;top:34vh;background:#6f8cf0;opacity:.2}
        [data-theme="dark"] .mo-blob{opacity:.22}
        [data-theme="dark"] .mo-blob.b2{opacity:.16}
        .mo-w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.12em;margin-bottom:-.12em}
        .mo-w>span{display:inline-block;will-change:transform}
        .btn,nav a.nav-cta{position:relative;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease,filter .2s ease,background .2s ease}
        .btn:hover,nav a.nav-cta:hover{transform:translateY(-2px);box-shadow:0 10px 24px #3157d540}
        .btn:active,nav a.nav-cta:active{transform:translateY(0) scale(.98)}
        .btn:not(.alt)::after,nav a.nav-cta::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,#ffffff55,transparent);transform:skewX(-20deg);transition:left .6s ease;pointer-events:none}
        .btn:not(.alt):hover::after,nav a.nav-cta:hover::after{left:130%}
        .card,.row-card{transition:transform .3s ease,box-shadow .3s ease,border-color .2s ease}
        .row-card:hover{transform:translateY(-3px);box-shadow:0 14px 32px #0b1f4d1f}
        html.lenis,html.lenis body{height:auto}
        .lenis.lenis-smooth{scroll-behavior:auto!important}
        .lenis.lenis-stopped{overflow:hidden}
        .mo-prog{position:fixed;left:0;top:0;height:3px;width:100%;background:linear-gradient(90deg,#3157d5,#7ea0ff);transform-origin:0 50%;transform:scaleX(0);z-index:60;pointer-events:none}
        main{animation:mo-pgin .45s cubic-bezier(.22,1,.36,1) both}
        @@keyframes mo-pgin{from{opacity:0}to{opacity:1}}
        html.mo-leaving main{opacity:0;transition:opacity .2s cubic-bezier(.22,1,.36,1)}
        .brand::after{display:inline-block;animation:mo-dot 2.8s ease-in-out infinite}
        .brand:hover::after{animation-duration:.9s}
        @@keyframes mo-dot{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-4px) scale(1.25)}}
        nav a:not(.nav-cta):not(.nav-ghost){background:linear-gradient(currentColor,currentColor) 0 100%/0 2px no-repeat;transition:background-size .3s cubic-bezier(.22,1,.36,1)}
        nav a:not(.nav-cta):not(.nav-ghost):hover{background-size:100% 2px;text-decoration:none}
        input:focus,textarea:focus,select:focus{box-shadow:0 0 0 4px #3157d530;transition:box-shadow .2s cubic-bezier(.22,1,.36,1),border-color .2s cubic-bezier(.22,1,.36,1)}
        .fx-spot{position:relative}
        .fx-spot>.fx-glow{position:absolute;inset:0;pointer-events:none;border-radius:inherit;opacity:0;transition:opacity .3s cubic-bezier(.22,1,.36,1);background:radial-gradient(260px circle at var(--sx,50%) var(--sy,50%),#3157d51c,transparent 70%)}
        .fx-spot:hover>.fx-glow{opacity:1}
        .job-card{transition:transform .25s cubic-bezier(.22,1,.36,1),background .2s cubic-bezier(.22,1,.36,1)}
        .job-card:hover{transform:translateX(6px)}
        .job-card h3::after{content:" \2192";opacity:0;display:inline-block;transform:translateX(-6px);transition:opacity .25s cubic-bezier(.22,1,.36,1),transform .25s cubic-bezier(.22,1,.36,1)}
        .job-card:hover h3::after{opacity:1;transform:none}
        @@media (prefers-reduced-motion:reduce){main{animation:none}.brand::after{animation:none}.job-card:hover{transform:none}}
    </style>
</head>
<body>
<header>
    <a class="brand" href="@(isAdmin ? "/Admin" : "/")">@siteName</a>
    @if (!isAdmin)
    {
        <form method="get" action="/Jobs" class="head-search"><input name="q" placeholder="Search for jobs" aria-label="Search jobs" /></form>
    }
    <nav>
        @if (isAdmin)
        {
            <a href="/Admin"@Html.Raw(Act("/Admin", true))>Home</a>
            <a href="/Admin/Users"@Html.Raw(Act("/Admin/Users"))>Users</a>
            <a href="/Admin/Transactions"@Html.Raw(Act("/Admin/Transactions"))>Transactions</a>
            <a href="/Admin/Applications"@Html.Raw(Act("/Admin/Applications"))>Review</a>
            <a href="/Admin/Logs"@Html.Raw(Act("/Admin/Logs"))>Logs</a>
        }
        else
        {
            <a href="/Jobs"@Html.Raw(Act("/Jobs"))>Browse jobs</a>
            @if (authed)
            {
                @if (User.IsInRole("Client")) { <a href="/Jobs/Create" class="nav-cta">Post a job</a> }
                @if (User.IsInRole("Freelancer")) { <a href="/Portfolio/Manage">My portfolio</a> }
                <a href="/Dashboard"@Html.Raw(Act("/Dashboard"))>Dashboard</a>
            }
            else
            {
                <a href="/Account/Login" class="nav-ghost">Log in</a>
                <a href="/Account/Register" class="nav-cta">Sign up</a>
            }
        }
        <button type="button" class="link" id="theme-toggle">Dark mode</button>
        @if (authed)
        {
            <details class="menu">
                <summary aria-label="Menu">Menu <span aria-hidden="true">&#9662;</span></summary>
                <div class="menu-panel">
                    <span class="menu-label">Settings</span>
                    <a href="/Account/Personal">Personal</a>
                    <a href="/Account/Security">Security</a>
                    <form method="post" asp-page="/Account/Logout" class="inline">
                        <button type="submit" class="link">Log out</button>
                    </form>
                </div>
            </details>
        }
    </nav>
</header>
<main class="@(ViewData["Wide"] is true ? "wide" : "")">@RenderBody()</main>
<footer>@siteName, the freelance marketplace for Egypt. Payments are arranged manually and confirmed by @siteName.</footer>
<script>
(function(){
  var b=document.querySelectorAll("#theme-toggle");
  function cur(){return document.documentElement.getAttribute("data-theme")==="dark"?"dark":"light";}
  function label(){b.forEach(function(x){x.textContent=cur()==="dark"?"Light mode":"Dark mode";});}
  b.forEach(function(x){x.addEventListener("click",function(){var n=cur()==="dark"?"light":"dark";document.documentElement.setAttribute("data-theme",n);try{localStorage.setItem("theme",n);}catch(e){}label();});});
  label();
  document.addEventListener("click",function(e){document.querySelectorAll("details.menu[open]").forEach(function(d){if(!d.contains(e.target))d.removeAttribute("open");});});
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/gsap@@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@@1.1.18/dist/lenis.min.js"></script>
<script>
(function(){
  try{
    if(!window.gsap)return;
    var reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if(reduce)return;
    var hasST=!!window.ScrollTrigger;
    if(hasST)gsap.registerPlugin(ScrollTrigger);
    var fine=window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    // 1) Lenis smooth scroll, driven by the GSAP ticker
    var lenis=null;
    if(window.Lenis){
      lenis=new Lenis({duration:1.1,smoothWheel:true,easing:function(t){return Math.min(1,1.001-Math.pow(2,-10*t));}});
      if(hasST)lenis.on("scroll",ScrollTrigger.update);
      gsap.ticker.add(function(t){lenis.raf(t*1000);});
      gsap.ticker.lagSmoothing(0);
    }

    // 2) Animated background: two soft blobs drifting slowly
    var bg=document.createElement("div");bg.className="mo-bg";bg.setAttribute("aria-hidden","true");
    bg.innerHTML='<div class="mo-blob b1"></div><div class="mo-blob b2"></div>';
    document.body.insertBefore(bg,document.body.firstChild);
    gsap.to(".mo-blob.b1",{x:"9vw",y:"8vh",duration:14,ease:"sine.inOut",repeat:-1,yoyo:true});
    gsap.to(".mo-blob.b2",{x:"-8vw",y:"-10vh",duration:17,ease:"sine.inOut",repeat:-1,yoyo:true});

    // 3) Split text reveal for the main heading (words slide up from a mask)
    var h=document.querySelector("main h1");
    if(h&&h.children.length===0&&h.textContent.trim()){
      var words=h.textContent.trim().split(/\s+/);
      h.setAttribute("aria-label",words.join(" "));
      h.innerHTML=words.map(function(w){return '<span class="mo-w" aria-hidden="true"><span>'+w.replace(/&/g,"&amp;").replace(/</g,"&lt;")+'</span></span>';}).join(" ");
      gsap.from(h.querySelectorAll(".mo-w>span"),{yPercent:115,opacity:0,duration:.9,ease:"power4.out",stagger:.07,delay:.1,clearProps:"all"});
    }

    // header and intro
    gsap.from("header",{y:-24,opacity:0,duration:.7,ease:"power3.out",clearProps:"all"});
    gsap.from(".home-sub,.home-search,main > .eyebrow,main > p:first-of-type",{y:18,opacity:0,duration:.8,ease:"power3.out",stagger:.1,delay:.35,clearProps:"all"});

    // 4) Scroll-triggered reveals
    if(hasST){
      var sel=".card,.row-card,.flow li,.facts li,main h2";
      var els=Array.prototype.filter.call(document.querySelectorAll(sel),function(e){return !e.closest(".home > aside")&&!e.closest("details.menu");});
      els.forEach(function(e){
        gsap.from(e,{y:32,opacity:0,duration:.8,ease:"power3.out",clearProps:"all",
          scrollTrigger:{trigger:e,start:"top 90%",once:true}});
      });
      window.addEventListener("load",function(){ScrollTrigger.refresh();});
    }
    gsap.from(".home > aside",{x:30,opacity:0,duration:.9,ease:"power3.out",delay:.45,clearProps:"all"});

    // 5) Button micro-interaction: gentle magnetic pull on desktop pointers
    if(fine){
      document.querySelectorAll(".btn:not(.alt),nav a.nav-cta").forEach(function(b){
        var xs=gsap.quickTo(b,"x",{duration:.4,ease:"power3.out"}),ys=gsap.quickTo(b,"y",{duration:.4,ease:"power3.out"});
        b.addEventListener("mousemove",function(e){var r=b.getBoundingClientRect();xs((e.clientX-r.left-r.width/2)*.12);ys((e.clientY-r.top-r.height/2)*.2);});
        b.addEventListener("mouseleave",function(){xs(0);ys(0);});
      });
    }

    // 6) Extra polish: staggered stats, chips, job rows, form fields, scroll parallax
    if(hasST){
      gsap.from(".stat",{y:34,opacity:0,duration:.8,ease:"power3.out",stagger:.1,clearProps:"all",scrollTrigger:{trigger:".stats",start:"top 92%",once:true}});
      gsap.from(".hw-step",{x:-26,opacity:0,duration:.7,ease:"power3.out",stagger:.1,clearProps:"all",scrollTrigger:{trigger:"#hw",start:"top 85%",once:true}});
      gsap.from(".hw-stage",{scale:.94,opacity:0,duration:.9,ease:"power3.out",clearProps:"all",scrollTrigger:{trigger:"#hw",start:"top 85%",once:true}});
      ScrollTrigger.batch(".job-card",{start:"top 94%",once:true,onEnter:function(b){gsap.from(b,{y:26,opacity:0,duration:.6,ease:"power3.out",stagger:.08,clearProps:"all"});}});
      gsap.to(".mo-blob.b1",{yPercent:35,ease:"none",scrollTrigger:{start:0,end:"max",scrub:true}});
      gsap.to(".mo-blob.b2",{yPercent:-30,ease:"none",scrollTrigger:{start:0,end:"max",scrub:true}});
    }
    gsap.from(".chips li",{y:16,opacity:0,scale:.9,duration:.6,ease:"back.out(1.7)",stagger:.07,delay:.8,clearProps:"all"});
    gsap.from(".float-badge",{opacity:0,scale:.6,duration:.7,ease:"back.out(2)",stagger:.25,delay:1,clearProps:"opacity,scale"});
    var ff=document.querySelectorAll("main .card form > *:not([type=hidden])");
    if(ff.length&&!document.querySelector(".home")){gsap.from(ff,{y:14,opacity:0,duration:.5,ease:"power2.out",stagger:.045,delay:.3,clearProps:"all"});}
    gsap.from(".brand",{scale:.85,opacity:0,duration:.7,ease:"back.out(2)",delay:.1,clearProps:"all"});
  }catch(e){try{console.warn("motion disabled",e);}catch(_){}}
})();
</script>
<script>
(function(){
  try{
    var reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var fine=window.matchMedia&&window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    // scroll progress bar
    var bar=document.createElement("div");bar.className="mo-prog";bar.setAttribute("aria-hidden","true");document.body.appendChild(bar);
    var tick=false;
    function upd(){tick=false;var d=document.documentElement,m=d.scrollHeight-window.innerHeight;bar.style.transform="scaleX("+(m>0?Math.min(1,window.scrollY/m):0)+")";}
    window.addEventListener("scroll",function(){if(!tick){tick=true;requestAnimationFrame(upd);}},{passive:true});
    window.addEventListener("resize",upd);upd();
    // cursor spotlight on cards (desktop only)
    if(fine){
      document.querySelectorAll(".card,.job-card,.row-card,.stat").forEach(function(c){
        if(c.closest("details.menu"))return;
        c.classList.add("fx-spot");
        var g=document.createElement("span");g.className="fx-glow";g.setAttribute("aria-hidden","true");c.appendChild(g);
        c.addEventListener("pointermove",function(e){var r=c.getBoundingClientRect();c.style.setProperty("--sx",(e.clientX-r.left)+"px");c.style.setProperty("--sy",(e.clientY-r.top)+"px");});
      });
    }
    // page transitions between internal pages
    if(!reduce){
      var root=document.documentElement;
      window.addEventListener("pageshow",function(e){root.classList.remove("mo-leaving");});
      document.addEventListener("click",function(e){
        if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;
        var a=e.target.closest&&e.target.closest("a[href]");
        if(!a||a.target||a.hasAttribute("download"))return;
        var u;try{u=new URL(a.href,location.href);}catch(x){return;}
        if(u.origin!==location.origin||u.protocol.indexOf("http")!==0)return;
        if(u.pathname===location.pathname&&u.search===location.search)return;
        if(/file|download|cv|logout|signin|external/i.test(u.pathname))return;
        e.preventDefault();
        root.classList.add("mo-leaving");
        setTimeout(function(){location.href=u.href;},200);
        setTimeout(function(){root.classList.remove("mo-leaving");},2500);
      });
    }
  }catch(e){try{console.warn("fx off",e);}catch(_){}}
})();
</script>
</body>
</html>
