@page
@model Marketplace.Pages.Jobs.CreateModel
@{ ViewData["Title"] = "Post a job"; }
<p class="eyebrow">Client</p>
<h1>Post a job</h1>
<form method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Input.Title">Title</label>
    <input asp-for="Input.Title" />
    <span asp-validation-for="Input.Title" class="error"></span>

    <label asp-for="Input.Description">Description</label>
    <textarea asp-for="Input.Description" rows="6"></textarea>
    <span asp-validation-for="Input.Description" class="error"></span>

    <label asp-for="Input.Budget">Budget</label>
    <input asp-for="Input.Budget" type="number" step="0.01" min="1" />
    <span asp-validation-for="Input.Budget" class="error"></span>

    <button type="submit" class="btn">Publish job</button>
</form>
