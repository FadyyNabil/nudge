@page "{id:int}"
@model Marketplace.Pages.Jobs.DetailsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = Model.Job!.Title; var cur = Config["Marketplace:Currency"]; var j = Model.Job!; }
<p class="eyebrow">Job · <span class="pill">@j.StatusLabel</span></p>
<h1>@j.Title</h1>
<p class="meta">Budget @j.Budget.ToString("N2") @cur · posted by @j.Client!.FullName · @j.CreatedAtUtc.ToString("yyyy-MM-dd")</p>
<p class="body-text">@j.Description</p>

@if (!string.IsNullOrEmpty(Model.Message)) { <p class="ok">@Model.Message</p> }
@if (!string.IsNullOrEmpty(Model.Error)) { <p class="error-box">@Model.Error</p> }

@if (Model.NudgeTargetId != null)
{
    @if (Model.NudgeAgainAtUtc != null)
    {
        var left = Model.NudgeAgainAtUtc.Value - DateTime.UtcNow;
        <p><button type="button" class="btn alt" disabled>Nudged ✓</button>
        <span class="meta">You can nudge again in @((int)left.TotalHours)h @(left.Minutes)m (at @Model.NudgeAgainAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC).</span></p>
    }
    else
    {
        <form method="post" asp-page-handler="Nudge" asp-route-id="@j.Id" class="inline">
            <button type="submit" class="btn">🔔 @Model.NudgeButtonText</button>
        </form>
    }
}
@if (j.Status == JobStatus.AwaitingPayment && (Model.IsOwner || Model.IsAdmin || Model.IsHiredFreelancer))
{
    <ul class="facts">
        <li><span>Agreed price</span><strong>@j.AgreedPrice?.ToString("N2") @cur</strong></li>
        <li><span>Money</span><strong>@(j.ProofUploadedAtUtc != null ? "Awaiting Nudge's payment confirmation" : "Not paid yet")</strong></li>
    </ul>
    @if (Model.IsOwner)
    {
        <p><a class="btn" href="/Jobs/Pay/@j.Id">@(j.ProofUploadedAtUtc != null ? "See payment status" : "Pay now and upload proof")</a></p>
    }
    else
    {
        <p class="body-text">The client was chosen and must now pay Nudge. The work starts when Nudge confirms the payment. We will email you.</p>
    }
}
@if (j.Status == JobStatus.Completed || j.Status == JobStatus.InProgress || j.Status == JobStatus.AwaitingPayout)
{
    <ul class="facts">
        <li><span>Agreed price</span><strong>@j.AgreedPrice?.ToString("N2") @cur</strong></li>
        @if (j.PaymentMethod is not null)
        {
            <li><span>Paid with</span><strong>@PaymentMethodNames.Label(j.PaymentMethod.Value)</strong></li>
        }
        @if (j.Escrow == EscrowStatus.Held)
        {
            <li><span>Money</span><strong>@(j.Status == JobStatus.AwaitingPayout ? "Approved, payout pending: Nudge will send the freelancer's share" : "Payment confirmed, held by Nudge until the client approves the work")</strong></li>
        }
        else if (j.Escrow == EscrowStatus.Released)
        {
            <li><span>Money</span><strong>Sent to the freelancer@(j.PayoutSentAtUtc != null ? " on " + j.PayoutSentAtUtc.Value.ToString("yyyy-MM-dd") : "")</strong></li>
        }
        @if (Model.IsOwner || Model.IsAdmin)
        {
            <li><span>Site commission (@j.CommissionPercent%)</span><strong>@j.CommissionAmount?.ToString("N2") @cur</strong></li>
            <li><span>Freelancer receives</span><strong>@((j.AgreedPrice - j.CommissionAmount)?.ToString("N2")) @cur</strong></li>
        }
    </ul>
}

@* ---------- Freelancer: apply ---------- *@
@if (Model.IsFreelancer && j.Status == JobStatus.Open)
{
    @if (Model.MyApplication is not null)
    {
        <p class="ok">You applied for @Model.MyApplication.ProposedPrice.ToString("N2") @cur. Status: @Marketplace.Pages.Jobs.DetailsModel.Describe(Model.MyApplication).</p>
    }
    else if (Model.MyPortfolioCount == 0)
    {
        <p class="error-box">Add at least one portfolio item before you apply. <a href="/Portfolio/Manage">Add portfolio</a></p>
    }
    else
    {
        <h2>Apply for this job</h2>
        <form method="post" asp-page-handler="Apply" asp-route-id="@j.Id" class="card">
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <label asp-for="Apply.CoverLetter">Cover letter</label>
            <textarea asp-for="Apply.CoverLetter" rows="5"></textarea>
            <span asp-validation-for="Apply.CoverLetter" class="error"></span>
            <label asp-for="Apply.ProposedPrice">Your price</label>
            <input asp-for="Apply.ProposedPrice" type="number" step="0.01" min="1" />
            <span asp-validation-for="Apply.ProposedPrice" class="error"></span>
            <button type="submit" class="btn">Send application</button>
        </form>
    }
}
else if (Model.IsFreelancer && Model.MyApplication is not null)
{
    <p class="ok">Your application: @Model.MyApplication.ProposedPrice.ToString("N2") @cur, status @Marketplace.Pages.Jobs.DetailsModel.Describe(Model.MyApplication).</p>
}
else if (!(User.Identity?.IsAuthenticated ?? false) && j.Status == JobStatus.Open)
{
    <p><a class="btn" href="/Account/Login?returnUrl=@Uri.EscapeDataString("/Jobs/Details/" + j.Id)">Log in to apply</a></p>
}

@* ---------- Final delivery: names visible, download locked until payment is held ---------- *@
@if ((Model.IsOwner || Model.IsAdmin || Model.IsHiredFreelancer) && (j.Status == JobStatus.InProgress || j.Status == JobStatus.Completed))
{
    <h2>Final delivery</h2>
    @if (!Model.Deliveries.Any()) { <p class="meta">No files sent yet.</p> }
    <ul class="plain">
        @foreach (var d in Model.Deliveries)
        {
            <li>
                @if (Model.CanDownload(d))
                {
                    <a href="/Jobs/DeliveryFile/@d.Id">@d.OriginalFileName</a>
                }
                else
                {
                    <strong>@d.OriginalFileName</strong> <span class="pill">available after the freelancer submits the work</span>
                }
                <span class="meta"> · @((d.Data.Length / 1024.0).ToString("N1")) KB · @d.UploadedAtUtc.ToString("yyyy-MM-dd")</span>
            </li>
        }
    </ul>
    @if (Model.IsOwner && j.Status == JobStatus.InProgress && !j.AwaitingApproval)
    {
        <p class="meta">The freelancer is working on it. You can review and download the files once they submit the work.</p>
    }
    @if (Model.IsHiredFreelancer && j.Status == JobStatus.InProgress && !j.AwaitingApproval)
    {
        @if (!string.IsNullOrEmpty(j.ChangeRequestNote))
        {
            <p class="error-box"><strong>The client asked for changes:</strong> @j.ChangeRequestNote</p>
        }
        <form method="post" enctype="multipart/form-data" asp-page-handler="Deliver" asp-route-id="@j.Id" class="card">
            <label asp-for="Delivery">Add the final result (PDF, image or ZIP, up to 5 MB)</label>
            <input asp-for="Delivery" type="file" accept=".pdf,.png,.jpg,.jpeg,.zip" />
            <span class="meta">The client cannot download files until you press Submit work for approval below.</span>
            <button type="submit" class="btn">Add file</button>
        </form>
    }
}

@* ---------- Hired freelancer: submit the work (money is released only after the client approves) ---------- *@
@if (Model.IsHiredFreelancer && j.Status == JobStatus.InProgress)
{
    @if (j.AwaitingApproval)
    {
        <h2>Waiting for the client</h2>
        <p class="body-text">You submitted the work on @j.DeliveredAtUtc?.ToString("yyyy-MM-dd"). The client can approve it or ask for changes.
            If they do not answer within @Marketplace.Models.Job.AutoReleaseDays days (by @j.DeliveredAtUtc?.AddDays(Marketplace.Models.Job.AutoReleaseDays).ToString("yyyy-MM-dd")),
            the work is approved automatically and Nudge sends you <strong>@((j.AgreedPrice - j.CommissionAmount)?.ToString("N2")) @cur</strong>.</p>
    }
    else
    {
        <h2>Submit your work</h2>
        <p class="body-text">
            Nudge is holding @j.AgreedPrice?.ToString("N2") @cur for this job. Add your files above, then submit.
            The client reviews your work and approves it. When they approve, you receive
            <strong>@((j.AgreedPrice - j.CommissionAmount)?.ToString("N2")) @cur</strong> (the agreed price minus @j.CommissionPercent% commission).
        </p>
        <form method="post" asp-page-handler="Submit" asp-route-id="@j.Id" class="inline">
            <button type="submit" class="btn">Submit work for approval</button>
        </form>
    }
}

@* ---------- Client: approve or ask for changes ---------- *@
@if (Model.IsOwner && j.AwaitingApproval)
{
    <h2>Review the delivered work</h2>
    <p class="body-text">The freelancer submitted their work on @j.DeliveredAtUtc?.ToString("yyyy-MM-dd"). Download the files above and check them.
        Approving tells Nudge to send the freelancer’s share. If you do not answer by @j.DeliveredAtUtc?.AddDays(Marketplace.Models.Job.AutoReleaseDays).ToString("yyyy-MM-dd"), the work is approved automatically.</p>
    <form method="post" asp-page-handler="Approve" asp-route-id="@j.Id" class="inline">
        <button type="submit" class="btn">Approve and release payment</button>
    </form>
    <form method="post" asp-page-handler="RequestChanges" asp-route-id="@j.Id" class="card">
        <label for="ChangeNote">Or ask for changes. What should the freelancer fix?</label>
        <textarea id="ChangeNote" name="ChangeNote" rows="3" maxlength="1000" required></textarea>
        <button type="submit" class="btn alt">Request changes</button>
    </form>
}

@* ---------- Admin: settle a stuck job ---------- *@
@if (Model.IsAdmin && j.Status == JobStatus.InProgress && j.Escrow == EscrowStatus.Held)
{
    <h2>Owner override</h2>
    <p class="meta">Use this only to settle a dispute. It overrides the client's approval step.</p>
    <form method="post" asp-page-handler="AdminResolve" asp-route-id="@j.Id" asp-route-decision="release" class="inline">
        <button type="submit" class="btn small">Release payment to the freelancer</button>
    </form>
    <form method="post" asp-page-handler="AdminResolve" asp-route-id="@j.Id" asp-route-decision="refund" class="inline">
        <button type="submit" class="btn small alt">Cancel job and refund the client</button>
    </form>
}

@* ---------- Job owner (or admin): applications + actions ---------- *@
@if (Model.IsOwner || Model.IsAdmin)
{
    <h2>Applications (@Model.Applications.Count)</h2>
    @if (!Model.Applications.Any()) { <p>No applications yet.</p> }
    @foreach (var a in Model.Applications)
    {
        <div class="card app">
            <div class="app-head">
                <strong>@a.Freelancer!.FullName</strong>
                @if (Model.IsAdmin) { <span class="pill">@Marketplace.Pages.Jobs.DetailsModel.Describe(a)</span> } else { <span class="pill">@a.Status</span> }
            </div>
            <p class="meta">Offer: @a.ProposedPrice.ToString("N2") @cur · @a.CreatedAtUtc.ToString("yyyy-MM-dd")</p>
            <p class="body-text">@a.CoverLetter</p>
            @if (Model.Portfolios.TryGetValue(a.FreelancerId, out var pf))
            {
                <p class="meta"><strong>Portfolio</strong></p>
                <ul class="plain">
                    @foreach (var it in pf)
                    {
                        <li>
                            <strong>@it.Title</strong>
                            @if (!string.IsNullOrEmpty(it.Description)) { <span class="meta"> · @it.Description</span> }
                            <br />
                            @if (!string.IsNullOrEmpty(it.Url)) { <a href="@it.Url" target="_blank" rel="noopener noreferrer nofollow">@it.Url</a> }
                            @if (!string.IsNullOrEmpty(it.StoredFileName)) { <text> </text><a href="/Portfolio/File/@it.Id">File: @it.OriginalFileName</a> }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="meta">No portfolio items.</p>
            }
            @if (Model.IsOwner && j.Status == JobStatus.Open && a.Status == ApplicationStatus.Pending)
            {
                <form method="post" asp-page-handler="Accept" asp-route-id="@j.Id" asp-route-appId="@a.Id" class="inline">
                    <label for="Price-@a.Id">Agreed price (@cur)</label>
                    <input id="Price-@a.Id" name="Price" type="number" step="0.01" min="1" max="1000000" value="@a.ProposedPrice" required />
                    <label for="Method-@a.Id">Pay with</label>
                    <select id="Method-@a.Id" name="Method" required>
                        <option value="">Choose payment method</option>
                        <option value="InstaPay">InstaPay</option>
                        <option value="VodafoneCash">Vodafone Cash</option>
                        <option value="OrangeCash">Orange Cash</option>
                        <option value="EtisalatCash">Etisalat Cash</option>
                        <option value="WePay">WE Pay</option>
                    </select>
                    <button type="submit" class="btn small">Accept, hire and pay</button>
                </form>
                <p class="meta">You choose the final price (the freelancer's offer is the starting point). Payment is arranged manually and confirmed by Nudge. Nudge holds it and pays the freelancer, minus the commission, once you approve the finished work.</p>
                <form method="post" asp-page-handler="Reject" asp-route-id="@j.Id" asp-route-appId="@a.Id" class="inline">
                    <button type="submit" class="btn small alt">Reject</button>
                </form>
            }
        </div>
    }
    @if (Model.IsOwner && (j.Status == JobStatus.Open || (j.Status == JobStatus.InProgress && !j.AwaitingApproval)))
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@j.Id" class="inline">
            <button type="submit" class="btn alt">Cancel job</button>
        </form>
    }
}

@if (Model.ShowChat)
{
    <h2 id="chat">Messages</h2>
    <div class="card" style="padding:18px">
        <div id="chat-list" class="chat-list">
            @if (!Model.Chat.Any()) { <p class="meta">No messages yet. Say hello and agree on the details.</p> }
            @foreach (var c in Model.Chat)
            {
                <div class="chat-row@(c.Mine ? " mine" : "")">
                    <p class="chat-meta"><strong>@c.Name</strong> <span class="pill">@c.RoleLabel</span> <span class="chat-time">@c.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></p>
                    <p class="chat-bubble">@c.Body</p>
                </div>
            }
        </div>
        @if (Model.CanChat)
        {
            <form method="post" asp-page-handler="SendMessage" asp-route-id="@Model.Job!.Id" class="chat-form">
                <label for="ChatText">Write a message</label>
                <textarea id="ChatText" name="ChatText" rows="2" maxlength="2000" required></textarea>
                <button class="btn small" type="submit">Send</button>
            </form>
        }
        else
        {
            <p class="meta">Only the client and the hired freelancer can write here. As admin you can read this conversation for disputes.</p>
        }
    </div>
    <style>
        .chat-list { max-height: 340px; overflow: auto; display: flex; flex-direction: column; gap: 12px; padding: 4px 2px; }
        .chat-row { max-width: 85%; align-self: flex-start; }
        .chat-row.mine { align-self: flex-end; text-align: right; }
        .chat-meta { margin: 0 0 2px; font-size: 12px; opacity: .75; }
        .chat-bubble { margin: 0; display: inline-block; background: color-mix(in srgb, #2e4fd0 13%, transparent); border-radius: 14px; padding: 10px 14px; text-align: left; white-space: pre-wrap; }
        .chat-row.mine .chat-bubble { background: #2e4fd0; color: #fff; }
        .chat-form { margin-top: 14px; }
        .chat-form textarea { width: 100%; margin-bottom: 8px; }
    </style>
    <script>
    (function () {
        var list = document.getElementById('chat-list');
        if (!list) return;
        var url = location.pathname + '?handler=Messages&id=@Model.Job!.Id';
        function nearBottom() { return list.scrollTop + list.clientHeight >= list.scrollHeight - 60; }
        function render(items) {
            var stick = nearBottom();
            list.innerHTML = '';
            if (!items.length) {
                var p = document.createElement('p'); p.className = 'meta';
                p.textContent = 'No messages yet. Say hello and agree on the details.';
                list.appendChild(p); return;
            }
            items.forEach(function (m) {
                var row = document.createElement('div'); row.className = 'chat-row' + (m.mine ? ' mine' : '');
                var meta = document.createElement('p'); meta.className = 'chat-meta';
                var who = document.createElement('strong'); who.textContent = m.n; meta.appendChild(who);
                meta.appendChild(document.createTextNode(' '));
                var pill = document.createElement('span'); pill.className = 'pill'; pill.textContent = m.r; meta.appendChild(pill);
                meta.appendChild(document.createTextNode(' '));
                var time = document.createElement('span'); time.className = 'chat-time';
                time.textContent = new Date(m.t).toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                meta.appendChild(time);
                var bubble = document.createElement('p'); bubble.className = 'chat-bubble'; bubble.textContent = m.b;
                row.appendChild(meta); row.appendChild(bubble);
                list.appendChild(row);
            });
            if (stick) list.scrollTop = list.scrollHeight;
        }
        list.scrollTop = list.scrollHeight;
        setInterval(function () {
            fetch(url, { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (items) { if (items) render(items); })
                .catch(function () { });
        }, 15000);
    })();
    </script>
}

@if (Model.IsAdmin && Model.NudgeHistory.Any())
{
    <h2>Nudge log (@Model.NudgeHistory.Count)</h2>
    <ul class="facts">
        @foreach (var n in Model.NudgeHistory)
        {
            <li><span>@n.From nudged @n.To</span><strong>@n.Log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC@(n.Log.DismissedAtUtc != null ? " (seen)" : "")</strong></li>
        }
    </ul>
}
