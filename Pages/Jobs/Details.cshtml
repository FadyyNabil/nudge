@page "{id:int}"
@model Marketplace.Pages.Jobs.DetailsModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = Model.Job!.Title; var cur = Config["Marketplace:Currency"]; var j = Model.Job!; }
<p class="eyebrow">Job · <span class="pill">@j.Status</span></p>
<h1>@j.Title</h1>
<p class="meta">Budget @j.Budget.ToString("N2") @cur · posted by @j.Client!.FullName · @j.CreatedAtUtc.ToString("yyyy-MM-dd")</p>
<p class="body-text">@j.Description</p>

@if (!string.IsNullOrEmpty(Model.Message)) { <p class="ok">@Model.Message</p> }
@if (!string.IsNullOrEmpty(Model.Error)) { <p class="error-box">@Model.Error</p> }

@if (j.Status == JobStatus.Completed || j.Status == JobStatus.InProgress)
{
    <ul class="facts">
        <li><span>Agreed price</span><strong>@j.AgreedPrice?.ToString("N2") @cur</strong></li>
        @if (j.PaymentMethod is not null)
        {
            <li><span>Paid with</span><strong>@PaymentMethodNames.Label(j.PaymentMethod.Value)</strong></li>
        }
        @if (Model.IsOwner || Model.IsAdmin)
        {
            <li><span>Site commission (@j.CommissionPercent%)</span><strong>@j.CommissionAmount?.ToString("N2") @cur</strong></li>
            <li><span>Freelancer receives</span><strong>@((j.AgreedPrice - j.CommissionAmount)?.ToString("N2")) @cur</strong></li>
        }
    </ul>
}

@* ---------- Freelancer: apply ---------- *@
@if (Model.IsFreelancer && j.Status == JobStatus.Open)
{
    @if (Model.MyApplication is not null)
    {
        <p class="ok">You applied for @Model.MyApplication.ProposedPrice.ToString("N2") @cur. Status: @Marketplace.Pages.Jobs.DetailsModel.Describe(Model.MyApplication).</p>
    }
    else if (Model.MyPortfolioCount == 0)
    {
        <p class="error-box">Add at least one portfolio item before you apply. <a href="/Portfolio/Manage">Add portfolio</a></p>
    }
    else
    {
        <h2>Apply for this job</h2>
        <form method="post" asp-page-handler="Apply" asp-route-id="@j.Id" class="card">
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <label asp-for="Apply.CoverLetter">Cover letter</label>
            <textarea asp-for="Apply.CoverLetter" rows="5"></textarea>
            <span asp-validation-for="Apply.CoverLetter" class="error"></span>
            <label asp-for="Apply.ProposedPrice">Your price</label>
            <input asp-for="Apply.ProposedPrice" type="number" step="0.01" min="1" />
            <span asp-validation-for="Apply.ProposedPrice" class="error"></span>
            <button type="submit" class="btn">Send application</button>
        </form>
    }
}
else if (Model.IsFreelancer && Model.MyApplication is not null)
{
    <p class="ok">Your application: @Model.MyApplication.ProposedPrice.ToString("N2") @cur, status @Marketplace.Pages.Jobs.DetailsModel.Describe(Model.MyApplication).</p>
}
else if (!(User.Identity?.IsAuthenticated ?? false) && j.Status == JobStatus.Open)
{
    <p><a class="btn" href="/Account/Login?returnUrl=@Uri.EscapeDataString("/Jobs/Details/" + j.Id)">Log in to apply</a></p>
}

@* ---------- Job owner (or admin): applications + actions ---------- *@
@if (Model.IsOwner || Model.IsAdmin)
{
    <h2>Applications (@Model.Applications.Count)</h2>
    @if (!Model.Applications.Any()) { <p>No applications yet.</p> }
    @foreach (var a in Model.Applications)
    {
        <div class="card app">
            <div class="app-head">
                <strong>@a.Freelancer!.FullName</strong>
                @if (Model.IsAdmin) { <span class="pill">@Marketplace.Pages.Jobs.DetailsModel.Describe(a)</span> } else { <span class="pill">@a.Status</span> }
            </div>
            <p class="meta">Offer: @a.ProposedPrice.ToString("N2") @cur · @a.CreatedAtUtc.ToString("yyyy-MM-dd")</p>
            <p class="body-text">@a.CoverLetter</p>
            @if (Model.Portfolios.TryGetValue(a.FreelancerId, out var pf))
            {
                <p class="meta"><strong>Portfolio</strong></p>
                <ul class="plain">
                    @foreach (var it in pf)
                    {
                        <li>
                            <strong>@it.Title</strong>
                            @if (!string.IsNullOrEmpty(it.Description)) { <span class="meta"> · @it.Description</span> }
                            <br />
                            @if (!string.IsNullOrEmpty(it.Url)) { <a href="@it.Url" target="_blank" rel="noopener noreferrer nofollow">@it.Url</a> }
                            @if (!string.IsNullOrEmpty(it.StoredFileName)) { <text> </text><a href="/Portfolio/File/@it.Id">File: @it.OriginalFileName</a> }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="meta">No portfolio items.</p>
            }
            @if (Model.IsOwner && j.Status == JobStatus.Open && a.Status == ApplicationStatus.Pending)
            {
                <form method="post" asp-page-handler="Accept" asp-route-id="@j.Id" asp-route-appId="@a.Id" class="inline">
                    <button type="submit" class="btn small">Accept and hire</button>
                </form>
                <form method="post" asp-page-handler="Reject" asp-route-id="@j.Id" asp-route-appId="@a.Id" class="inline">
                    <button type="submit" class="btn small alt">Reject</button>
                </form>
            }
        </div>
    }
    @if (Model.IsOwner && j.Status == JobStatus.InProgress)
    {
        <form method="post" asp-page-handler="Complete" asp-route-id="@j.Id" class="inline">
            <label for="Method">Paid with</label>
            <select id="Method" name="Method" required>
                <option value="">Choose payment method</option>
                <option value="InstaPay">InstaPay</option>
                <option value="VodafoneCash">Vodafone Cash</option>
                <option value="OrangeCash">Orange Cash</option>
                <option value="EtisalatCash">Etisalat Cash</option>
                <option value="WePay">WE Pay</option>
            </select>
            <button type="submit" class="btn">Mark as paid and completed</button>
        </form>
    }
    @if (Model.IsOwner && (j.Status == JobStatus.Open || j.Status == JobStatus.InProgress))
    {
        <form method="post" asp-page-handler="Cancel" asp-route-id="@j.Id" class="inline">
            <button type="submit" class="btn alt">Cancel job</button>
        </form>
    }
}
