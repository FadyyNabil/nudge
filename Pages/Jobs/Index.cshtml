@page
@model Marketplace.Pages.Jobs.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ ViewData["Title"] = "Browse jobs"; var cur = Config["Marketplace:Currency"]; }
<p class="eyebrow">Open jobs</p>
<h1>Browse jobs</h1>
<form method="get" class="search">
    <input name="q" value="@Model.Q" placeholder="Search title or description" aria-label="Search jobs" />
    <button class="btn" type="submit">Search</button>
</form>
@if (!Model.Jobs.Any())
{
    <p>No open jobs found.</p>
}
@foreach (var j in Model.Jobs)
{
    <a class="row-card" href="/Jobs/Details/@j.Id">
        <strong>@j.Title</strong>
        <span class="meta">@j.Budget.ToString("N2") @cur · posted by @j.Client!.FullName · @j.CreatedAtUtc.ToString("yyyy-MM-dd")</span>
    </a>
}
